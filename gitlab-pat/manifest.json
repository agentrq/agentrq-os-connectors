{
  "$schema": "https://connectors.agentrq.com/schemas/manifest/v1.json",
  "auth": {
    "required": true,
    "schemes": [
      {
        "type": "bearer"
      }
    ]
  },
  "description": "Work with GitLab through task-shaped tools, authenticated with a personal access token: propose multi-file changes as merge requests, read and write files, and manage projects, branches, commits, issues, merge requests and pipelines.",
  "icons": [
    {
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ],
      "src": "https://raw.githubusercontent.com/agentrq/agentrq-os-connectors/main/gitlab-pat/icon.svg"
    }
  ],
  "inputs": [
    {
      "default": "https://gitlab.com/api/v4",
      "description": "Where the API is; it must be allowed below",
      "name": "api_base",
      "title": "API base URL",
      "type": "string"
    }
  ],
  "limits": {
    "timeoutMs": 20000
  },
  "manifestVersion": 1,
  "mcpVersion": "2026-07-28",
  "name": "gitlab-pat",
  "permissions": {
    "http": {
      "allow": [
        "https://gitlab.com"
      ]
    }
  },
  "title": "GitLab (token)",
  "tools": [
    {
      "annotations": {
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true
