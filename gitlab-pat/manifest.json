      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "project_id": {
            "description": "The project ID or URL-encoded path (namespace/project)",
            "type": "string"
          }
        },
        "required": [
          "project_id"
        ],
        "type": "object"
      },
      "name": "getProject",
      "title": "Get a project"
    },
    {
      "annotations": {
        "idempotentHint": true,
