{
  "$schema": "https://connectors.agentrq.com/schemas/manifest/v1.json",
  "auth": {
    "required": true,
    "schemes": [
      {
        "authorizationUrl": "https://api.notion.com/v1/oauth/authorize",
        "clientSecretRequired": true,
        "extraAuthParams": {
          "owner": "user"
        },
        "grants": [
          "authorization_code"
        ],
        "pkce": true,
        "tokenUrl": "https://api.notion.com/v1/oauth/token",
        "type": "oauth2"
      }
    ]
  },
  "description": "Work with Notion through outcome-oriented tools: pages, data sources (databases), Markdown content and comments. Titles resolve to ids and properties read and write as plain values, so the agent makes one call per outcome instead of choreographing API calls. Authenticated with OAuth 2.0; the host runs the sign-in.",
  "icons": [
    {
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ],
      "src": "https://raw.githubusercontent.com/agentrq/agentrq-os-connectors/main/notion/icon.svg"
    }
  ],
  "inputs": [
    {
      "default": "https://api.notion.com",
      "description": "Where the API is; it must be allowed below",
      "name": "api_base",
      "title": "API base URL",
      "type": "string"
    }
  ],
  "instructions": "Notion workspace connector. Pages and data sources (Notion's databases) are referenced by title or id wherever a tool takes one: titles are resolved inside the connector, and an ambiguous title fails listing the matches so you can pick an id. Properties are read and written as plain values: title and rich text as strings, numbers as numbers, checkboxes as booleans, select and status as the option name, multi-select as an array of names, dates as YYYY-MM-DD strings or {start, end} objects, people and relations as id arrays; null values are ignored on write. queryDataSource filters use the same plain style: {\"Status\": \"Done\"} means equals, {\"Due\": {\"before\": \"2026-12-01\"}} uses an operator (equals, contains, before, after, greater_than, less_than, is_empty, ...), combined with and/or groups. Page content is Markdown: getPage with includeContent reads it, createPage and appendContent write it (headings, lists, todos, quotes, code fences and dividers supported). The connector pins Notion-Version 2026-03-11; trashed pages report inTrash. One tool call may make several API calls internally to finish the outcome.",
  "limits": {
    "timeoutMs": 20000
  },
  "manifestVersion": 1,
  "mcpVersion": "2026-07-28",
  "name": "notion",
  "permissions": {
    "http": {
      "allow": [
        "https://api.notion.com"
      ]
    }
  },
  "title": "Notion",
  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": true,
        "readOnlyHint": true
      },
      "description": "Search the workspace for pages and data sources by title; returns compact matches with ids, types and urls",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "filter": {
            "description": "Limit results to pages, data sources, or both",
            "enum": [
              "all",
              "dataSource",
              "page"
            ],
            "type": "string"
          },
          "pageSize": {
            "description": "Maximum results to return",
            "type": "integer"
          },
          "query": {
            "description": "Title text to search for",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "name": "searchWorkspace"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": true,
        "readOnlyHint": true
      },
      "description": "Get a page by id with its properties as plain values; set includeContent to also read the page body as Markdown",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "includeContent": {
            "description": "Also return the page body as Markdown",
            "type": "boolean"
          },
          "pageId": {
            "description": "The page id",
            "type": "string"
          }
        },
        "required": [
          "pageId"
        ],
        "type": "object"
      },
      "name": "getPage"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": true,
        "readOnlyHint": false
      },
      "description": "Create a page in one call: parent data source or page by title or id, properties as plain values, optional Markdown content",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "description": "Page body as Markdown (headings, lists, todos, quotes, code fences, dividers)",
            "type": "string"
          },
          "parent": {
            "additionalProperties": false,
            "description": "Where to create the page",
            "properties": {
              "dataSource": {
                "description": "Data source title or id; the page becomes a row in it",
                "type": "string"
              },
              "page": {
                "description": "Parent page title or id; the page becomes a sub-page",
                "type": "string"
              }
            },
            "type": "object"
          },
          "properties": {
            "additionalProperties": true,
            "description": "Property values by name as plain values: strings, numbers, booleans, date strings (YYYY-MM-DD), arrays of strings",
            "type": "object"
          }
        },
        "required": [
          "parent"
        ],
        "type": "object"
      },
      "name": "createPage"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": true,
        "readOnlyHint": false
      },
      "description": "Update a page's properties by name with plain values; set trash true to move it to trash, false to restore it",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "pageId": {
            "description": "The page id",
            "type": "string"
          },
          "properties": {
            "additionalProperties": true,
            "description": "Property values by name as plain values; null values are ignored",
            "type": "object"
          },
          "trash": {
            "description": "True moves the page to trash, false restores it",
            "type": "boolean"
          }
        },
        "required": [
          "pageId"
        ],
        "type": "object"
      },
      "name": "updatePage"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": true,
        "readOnlyHint": false
      },
      "description": "Move a page to a new parent page, given as a title or an id",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "pageId": {
            "description": "The page id",
            "type": "string"
          },
          "parent": {
            "description": "New parent page title or id",
            "type": "string"
          }
        },
        "required": [
          "pageId",
          "parent"
        ],
        "type": "object"
      },
      "name": "movePage"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": true,
        "readOnlyHint": true
      },
      "description": "Query a data source (by title or id) with simple filters and sorts; returns rows with properties as plain values",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "dataSource": {
            "description": "Data source title or id",
            "type": "string"
          },
          "filter": {
            "additionalProperties": true,
            "description": "Simple filter, e.g. {\"Status\": \"Done\"} or {\"Due\": {\"before\": \"2026-12-01\"}}, with and/or groups",
            "type": "object"
          },
          "pageSize": {
            "description": "Maximum rows to return",
            "type": "integer"
          },
          "sorts": {
            "description": "Sorts like [{\"property\": \"Due\", \"direction\": \"ascending\"}]",
            "items": {
              "additionalProperties": false,
              "properties": {
                "direction": {
                  "enum": [
                    "ascending",
                    "descending"
                  ],
                  "type": "string"
                },
                "property": {
                  "type": "string"
                },
                "timestamp": {
                  "enum": [
                    "created_time",
                    "last_edited_time"
                  ],
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "startCursor": {
            "description": "Pagination cursor from a previous call",
            "type": "string"
          }
        },
        "required": [
          "dataSource"
        ],
        "type": "object"
      },
      "name": "queryDataSource"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": true,
        "readOnlyHint": true
      },
      "description": "Get a data source's schema (by title or id): property names, types and select options",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "dataSource": {
            "description": "Data source title or id",
            "type": "string"
          }
        },
        "required": [
          "dataSource"
        ],
        "type": "object"
      },
      "name": "getDataSource"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": true,
        "readOnlyHint": false
      },
      "description": "Create a data source (database) under a parent page with a simple property schema, in one call",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "parent": {
            "description": "Parent page title or id",
            "type": "string"
          },
          "properties": {
            "description": "Property definitions in order",
            "items": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "description": "Property name",
                  "type": "string"
                },
                "options": {
                  "description": "Option names for select, multi_select and status",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "type": {
                  "description": "Property type",
                  "enum": [
                    "checkbox",
                    "date",
                    "email",
                    "multi_select",
                    "number",
                    "people",
                    "phone_number",
                    "rich_text",
                    "select",
                    "status",
                    "title",
                    "url"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "name",
                "type"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "title": {
            "description": "Data source title",
            "type": "string"
          }
        },
        "required": [
          "parent",
          "properties",
          "title"
        ],
        "type": "object"
      },
      "name": "createDataSource"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": true,
        "readOnlyHint": false
      },
      "description": "Append Markdown content to a page; converted to blocks internally",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "markdown": {
            "description": "Markdown to append",
            "type": "string"
          },
          "pageId": {
            "description": "The page id",
            "type": "string"
          }
        },
        "required": [
          "markdown",
          "pageId"
        ],
        "type": "object"
      },
      "name": "appendContent"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": true,
        "readOnlyHint": true
      },
      "description": "List the comments on a page, newest last",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "pageId": {
            "description": "The page id",
            "type": "string"
          },
          "pageSize": {
            "description": "Maximum comments to return",
            "type": "integer"
          },
          "startCursor": {
            "description": "Pagination cursor from a previous call",
            "type": "string"
          }
        },
        "required": [
          "pageId"
        ],
        "type": "object"
      },
      "name": "listComments"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": true,
        "readOnlyHint": false
      },
      "description": "Comment on a page; pass discussionId to reply in an existing thread",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "discussionId": {
            "description": "Discussion id to reply to",
            "type": "string"
          },
          "pageId": {
            "description": "The page id",
            "type": "string"
          },
          "text": {
            "description": "Comment text",
            "type": "string"
          }
        },
        "required": [
          "pageId",
          "text"
        ],
        "type": "object"
      },
      "name": "createComment"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": true,
        "readOnlyHint": true
      },
      "description": "The authenticated user or bot: id, name and workspace",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "name": "getCurrentUser"
    }
  ],
  "version": "0.1.0",
  "websiteUrl": "https://www.notion.so"
}
