          },
          "per_page": {
            "description": "Results per page, up to 100",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "repo": {
            "description": "The repository name",
            "type": "string"
          },
          "sha": {
            "description": "Branch, tag or SHA to list commits from",
