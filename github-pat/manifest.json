{
  "$schema": "https://connectors.agentrq.com/schemas/manifest/v1.json",
  "auth": {
    "required": true,
    "schemes": [
      {
        "type": "bearer"
      }
    ]
  },
  "description": "Work with GitHub through outcome-oriented tools: repositories, branches, commits, files, issues, pull requests and Actions workflow runs.",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/agentrq/agentrq-os-connectors/main/github-pat/icon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "inputs": [
    {
      "default": "https://api.github.com",
      "description": "Where the API is; it must be allowed below",
      "name": "api_base",
      "title": "API base URL",
      "type": "string"
    }
  ],
  "limits": {
    "timeoutMs": 20000
  },
  "manifestVersion": 1,
  "mcpVersion": "2026-07-28",
  "name": "github-pat",
  "permissions": {
    "http": {
      "allow": [
        "https://api.github.com"
      ]
    }
  },
  "title": "GitHub (token)",
  "tools": [
    {
      "annotations": {
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true
      },
      "description": "Repository details: description, visibility, default branch, counts and URLs",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "owner": {
            "description": "The repository owner's login",
            "type": "string"
          },
          "repo": {
            "description": "The repository name",
            "type": "string"
          }
        },
        "required": [
          "owner",
          "repo"
        ],
        "type": "object"
      },
      "name": "getRepo",
      "title": "Get repository"
    },
    {
      "annotations": {
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true
      },
      "description": "Repositories the signed-in user can access",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "direction": {
            "description": "Sort direction: asc or desc",
            "type": "string"
          },
          "owner": {
            "description": "The repository owner's login",
            "type": "string"
          },
          "page": {
            "description": "Page number, starting at 1",
            "type": "integer",
            "minimum": 1
          },
          "per_page": {
            "description": "Results per page, up to 100",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "repo": {
            "description": "The repository name",
            "type": "string"
          },
          "sort": {
            "description": "Sort by: created, updated, pushed, full_name",
            "type": "string"
          },
          "type": {
            "description": "Filter by affiliation: all, owner, member",
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "name": "listRepos",
      "title": "List repositories"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": true,
        "readOnlyHint": false
      },
      "description": "Create a repository for the signed-in user",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "auto_init": {
            "description": "Initialize with a README",
            "type": "boolean"
          },
          "description": {
            "description": "A short description",
            "type": "string"
          },
          "name": {
            "description": "The repository name",
            "type": "string"
          },
          "private": {
            "description": "Whether the repository is private",
            "type": "boolean"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "name": "createRepo",
      "title": "Create repository"
    },
    {
      "annotations": {
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true
      },
      "description": "Read a file's content as decoded text \u2014 no base64 handling needed; binary files come back as base64 with isBinary: true",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "owner": {
            "description": "The repository owner's login",
            "type": "string"
          },
          "path": {
            "description": "File path, e.g. src/lib.rs",
            "type": "string"
          },
          "ref": {
            "description": "Branch, tag or commit SHA; the default branch when omitted",
            "type": "string"
          },
          "repo": {
            "description": "The repository name",
            "type": "string"
          }
        },
        "required": [
          "owner",
          "repo",
          "path"
        ],
        "type": "object"
      },
      "name": "readFile",
      "title": "Read file"
    },
    {
      "annotations": {
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true
      },
      "description": "List a directory's entries (name, path, type, sha, size); defaults to the repository root",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "owner": {
            "description": "The repository owner's login",
            "type": "string"
          },
          "path": {
            "description": "Directory path, e.g. docs; the repository root when omitted",
            "type": "string"
          },
          "ref": {
            "description": "Branch, tag or commit SHA; the default branch when omitted",
            "type": "string"
          },
          "repo": {
            "description": "The repository name",
            "type": "string"
          }
        },
        "required": [
          "owner",
          "repo"
        ],
        "type": "object"
      },
      "name": "listDirectory",
      "title": "List directory"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": true,
        "readOnlyHint": false
      },
      "description": "Create or update a file with plain-text content; the current SHA is resolved internally, so no lookup call is needed",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "branch": {
            "description": "Branch to commit to",
            "type": "string"
          },
          "content": {
            "description": "The new file content as plain text",
            "type": "string"
          },
          "message": {
            "description": "The commit message",
            "type": "string"
          },
          "owner": {
            "description": "The repository owner's login",
            "type": "string"
          },
          "path": {
            "description": "File path, e.g. docs/notes.md",
            "type": "string"
          },
          "repo": {
            "description": "The repository name",
            "type": "string"
          }
        },
        "required": [
          "owner",
          "repo",
          "path",
          "branch",
          "content",
          "message"
        ],
        "type": "object"
      },
      "name": "writeFile",
      "title": "Write file"
    },
    {
      "annotations": {
        "destructiveHint": true,
        "openWorldHint": true,
        "readOnlyHint": false
      },
      "description": "Delete a file; its SHA is resolved internally, so no lookup call is needed",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "branch": {
            "description": "Branch to commit the deletion to",
            "type": "string"
          },
          "message": {
            "description": "The commit message; defaults to \"delete {path}\"",
            "type": "string"
          },
          "owner": {
            "description": "The repository owner's login",
            "type": "string"
          },
          "path": {
            "description": "File path, e.g. docs/notes.md",
            "type": "string"
          },
          "repo": {
            "description": "The repository name",
            "type": "string"
          }
        },
        "required": [
          "owner",
          "repo",
          "path",
          "branch"
        ],
        "type": "object"
      },
      "name": "deleteFile",
      "title": "Delete file"
    },
    {
      "annotations": {
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true
      },
      "description": "List a repository's branches",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "owner": {
            "description": "The repository owner's login",
            "type": "string"
          },
          "page": {
            "description": "Page number, starting at 1",
            "type": "integer",
            "minimum": 1
          },
          "per_page": {
            "description": "Results per page, up to 100",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "repo": {
            "description": "The repository name",
            "type": "string"
          }
