{
  "$schema": "https://connectors.agentrq.com/schemas/manifest/v1.json",
  "auth": {
    "required": true,
    "schemes": [
      {
        "authorizationUrl": "https://accounts.google.com/o/oauth2/v2/auth",
        "clientSecretRequired": true,
        "extraAuthParams": {
          "access_type": "offline",
          "prompt": "select_account consent"
        },
        "grants": [
          "authorization_code"
        ],
        "pkce": true,
        "scopes": [
          "https://www.googleapis.com/auth/spreadsheets"
        ],
        "tokenUrl": "https://oauth2.googleapis.com/token",
        "type": "oauth2"
      }
    ]
  },
  "description": "Read, write and manage Google Sheets with task-shaped tools: read ranges or whole tables, update cells, append rows, clear ranges, create spreadsheets with their initial data, inspect structure, and batch updates.",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/agentrq/agentrq-os-connectors/main/gsheets/icon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "inputs": [
    {
      "default": "https://sheets.googleapis.com",
      "description": "Where the API is; it must be allowed below",
      "name": "api_base",
      "title": "API base URL",
      "type": "string"
    }
  ],
  "limits": {
    "timeoutMs": 20000
  },
  "manifestVersion": 1,
  "mcpVersion": "2026-07-28",
  "name": "gsheets",
  "permissions": {
    "http": {
      "allow": [
        "https://sheets.googleapis.com"
      ]
    }
  },
  "title": "Google Sheets",
  "tools": [
    {
      "annotations": {
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true
      },
      "description": "Read values from a range, e.g. Sheet1!A1:D10",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "majorDimension": {
            "description": "ROWS or COLUMNS",
            "type": "string"
          },
          "range": {
            "description": "A1 notation of the range to read, e.g. Sheet1!A1:D10",
            "type": "string"
          },
          "spreadsheetId": {
            "description": "The spreadsheet's ID",
            "type": "string"
          },
          "valueRenderOption": {
            "description": "FORMATTED_VALUE, UNFORMATTED_VALUE or FORMULA",
            "type": "string"
          }
        },
        "required": [
          "spreadsheetId",
          "range"
        ],
        "type": "object"
      },
      "name": "getValues",
      "title": "Read a range"
    },
    {
      "annotations": {
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true
      },
      "description": "Read a range as a table: the first row becomes headers, the rest become objects",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "majorDimension": {
            "description": "ROWS or COLUMNS",
            "type": "string"
          },
          "range": {
            "description": "A1 notation of the table range, e.g. Sheet1!A1:D",
            "type": "string"
          },
          "spreadsheetId": {
            "description": "The spreadsheet's ID",
            "type": "string"
          },
          "valueRenderOption": {
            "description": "FORMATTED_VALUE, UNFORMATTED_VALUE or FORMULA",
            "type": "string"
          }
        },
        "required": [
          "spreadsheetId",
          "range"
        ],
        "type": "object"
      },
      "name": "readTable",
      "title": "Read a table"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": false
      },
      "description": "Write values into a range in place",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "range": {
            "description": "A1 notation of the range to write, e.g. Sheet1!A1:B2",
            "type": "string"
          },
          "spreadsheetId": {
            "description": "The spreadsheet's ID",
            "type": "string"
          },
          "valueInputOption": {
            "description": "USER_ENTERED (default) parses dates, currency and formulas; RAW stores values as-is",
            "type": "string"
          },
          "values": {
            "description": "Rows of values to write; each inner array is one row",
            "items": {
              "type": "array"
            },
            "type": "array"
          }
        },
        "required": [
          "spreadsheetId",
          "range",
          "values"
        ],
        "type": "object"
      },
      "name": "updateValues",
      "title": "Write cells"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": true,
        "readOnlyHint": false
      },
      "description": "Append rows of values after the last row of a table",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "insertDataOption": {
            "description": "INSERT_ROWS (default) shifts existing rows down; OVERWRITE overwrites",
            "type": "string"
          },
          "range": {
            "description": "A1 notation of the table range, e.g. Sheet1!A:D",
            "type": "string"
          },
          "spreadsheetId": {
            "description": "The spreadsheet's ID",
            "type": "string"
          },
          "valueInputOption": {
            "description": "USER_ENTERED (default) parses dates, currency and formulas; RAW stores values as-is",
            "type": "string"
          },
          "values": {
            "description": "Rows of values to append; each inner array is one row",
            "items": {
              "type": "array"
            },
            "type": "array"
          }
        },
        "required": [
          "spreadsheetId",
          "range",
          "values"
        ],
        "type": "object"
      },
      "name": "appendValues",
      "title": "Append rows"
    },
    {
      "annotations": {
        "destructiveHint": true,
        "openWorldHint": true,
        "readOnlyHint": false
      },
      "description": "Clear all values from a range, keeping formatting",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "range": {
            "description": "A1 notation of the range to clear, e.g. Sheet1!A1:D10",
            "type": "string"
          },
          "spreadsheetId": {
            "description": "The spreadsheet's ID",
            "type": "string"
          }
        },
        "required": [
          "spreadsheetId",
          "range"
        ],
        "type": "object"
      },
      "name": "clearValues",
      "title": "Clear a range"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": true,
        "readOnlyHint": false
      },
      "description": "Create a spreadsheet, optionally with named sheets and their initial rows",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "sheets": {
            "description": "Sheets to create; each may carry initial rows, written top-left",
            "items": {
              "additionalProperties": false,
              "properties": {
                "rows": {
                  "description": "Initial rows for the sheet; each inner array is one row",
                  "items": {
                    "type": "array"
                  },
                  "type": "array"
                },
                "title": {
                  "description": "Title of the sheet",
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "title"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "title": {
            "description": "Title of the new spreadsheet",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "type": "object"
      },
      "name": "createSpreadsheet",
      "title": "Create a spreadsheet"
    },
    {
      "annotations": {
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true
      },
      "description": "Get a spreadsheet's metadata: tabs, properties and optionally grid data",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "includeGridData": {
            "description": "Include cell data and formatting",
            "type": "boolean"
          },
          "ranges": {
            "description": "Limit the response to these A1 ranges",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "spreadsheetId": {
            "description": "The spreadsheet's ID",
            "type": "string"
          }
        },
        "required": [
          "spreadsheetId"
        ],
        "type": "object"
      },
      "name": "getSpreadsheet",
      "title": "Inspect a spreadsheet"
    },
    {
      "annotations": {
        "destructiveHint": true,
        "openWorldHint": true,
        "readOnlyHint": false
      },
      "description": "Apply structural and formatting changes: add tabs, format cells, freeze rows, set column widths",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "requests": {
            "description": "Sheets API request objects, e.g. addSheet, updateSheetProperties, repeatCell",
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "spreadsheetId": {
            "description": "The spreadsheet's ID",
            "type": "string"
          }
        },
        "required": [
          "spreadsheetId",
          "requests"
        ],
        "type": "object"
      },
      "name": "batchUpdate",
      "title": "Batch update"
    }
  ],
  "version": "0.2.0",
  "websiteUrl": "https://developers.google.com/workspace/sheets/api",
  "instructions": "Prefer readTable over getValues when the first row is a header — it returns {headers, rows} objects so the agent never indexes into nested arrays; getValues stays for raw ranges and index math. updateValues writes in place (USER_ENTERED by default), appendValues adds rows after the last row, and clearValues empties cells while keeping formatting. createSpreadsheet can take named sheets with their initial rows in the same call, and quotes sheet titles in A1 notation automatically. getSpreadsheet inspects tabs and grid properties; batchUpdate is the escape hatch for structural and formatting changes."
}
